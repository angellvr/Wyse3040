# Copia este fichero a .env y rellénalo. .env NUNCA se sube a GitHub.

# --- Claude (https://console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
MODELO=claude-opus-5-5
# Para abaratar la clasificación de correos puedes usar claude-haiku-5-5
MODELO_CLASIFICADOR=claude-opus-5-5
# low | medium | high
ESFUERZO=medium

# --- Telegram (crea el bot con @BotFather; tu ID te lo da @userinfobot) ---
TELEGRAM_TOKEN=
TELEGRAM_USUARIOS_PERMITIDOS=123456789

# --- Tareas ---
INTERVALO_CORREO_MIN=15
# Vacío para desactivar. Se envía de lunes a viernes.
HORA_RESUMEN_DIARIO=08:30
ZONA_HORARIA=Europe/Madrid

# --- Google Drive ---
# Nombre de la carpeta que el asistente creará en tu Drive (luego puedes moverla)
DRIVE_CARPETA_FACTURAS=Facturas
GOOGLE_CLIENTE=data/google_client_secret.json
GOOGLE_TOKEN=data/google_token.json

# --- Odoo (Preferencias de usuario → Seguridad → Claves API). Usuario con permisos de solo lectura ---
ODOO_URL=https://tuempresa.odoo.com
ODOO_DB=
ODOO_USUARIO=
ODOO_API_KEY=

# --- Stripe: clave RESTRINGIDA de solo lectura (Developers → API keys → Create restricted key) ---
STRIPE_API_KEY=rk_live_

# --- CRM propio ---
CRM_URL=
CRM_TOKEN=

# --- Contraseñas de correo (contraseñas de aplicación; se referencian desde config/cuentas.yaml) ---
CORREO_PRINCIPAL_PASSWORD=
CORREO_FACTURAS_PASSWORD=
